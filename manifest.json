{
  "manifest_version": 3,
  "name": "豆瓣 & IMDb 评分",
  "version": "0.4.0",
  "description": "在 Netflix 与 Prime Video 的影片封面旁并排显示豆瓣与 IMDb 评分，点击可跳转对应条目。",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://search.douban.com/*",
    "https://movie.douban.com/*",
    "https://v3.sg.media-imdb.com/*",
    "https://v2.sg.media-imdb.com/*",
    "https://api.graphql.imdb.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content-netflix.js"
      ],
      "css": [
        "badge.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.fr/gp/video/*",
        "https://*.amazon.it/gp/video/*",
        "https://*.amazon.es/gp/video/*",
        "https://*.amazon.nl/gp/video/*",
        "https://*.amazon.se/gp/video/*",
        "https://*.amazon.pl/gp/video/*",
        "https://*.amazon.ca/gp/video/*",
        "https://*.amazon.com.au/gp/video/*",
        "https://*.amazon.com.br/gp/video/*",
        "https://*.amazon.com.mx/gp/video/*",
        "https://*.amazon.in/gp/video/*",
        "https://*.amazon.sg/gp/video/*",
        "https://*.amazon.ae/gp/video/*",
        "https://*.amazon.sa/gp/video/*",
        "https://*.amazon.com.tr/gp/video/*",
        "https://*.amazon.com.be/gp/video/*"
      ],
      "js": [
        "content-primevideo.js"
      ],
      "css": [
        "badge.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "豆瓣 & IMDb 评分",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
